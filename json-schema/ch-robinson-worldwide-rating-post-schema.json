          "minimum": 1,
          "maximum": 25,
          "description": "United Nations Code for trade and transport locations."
        },
        "iata": {
          "type": "string",
          "minimum": 1,
          "maximum": 10,
          "description": "IATA station code or simply a location identifier, is a three-letter code designating many airports around the world. Defined by the International Air Transport Association (IATA)."
