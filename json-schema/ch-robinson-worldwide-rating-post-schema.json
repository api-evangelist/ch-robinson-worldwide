    "temperatureSensitiveEnum": {
      "type": "string",
      "description": "Indicates if temperature control is needed, and what level:\n  * `Dry` - Dry\n  * `Fresh` - Fresh (25 to 32 degrees)\n  * `Frozen` - Frozen (-10 to 0 degrees)\n  * `Chilled` - Chilled (40 to 60 degrees)\n  * `DeepFrozen` - Deep Frozen (-20 to -20 degrees)\n  * `Refrigerated` - Refrigerated (33 to 39 degrees)\n  * `Protect` - Protect (33 to 60 degrees)\n  * `Custom` - Custom\n  * `Produce` - Produce\n  * `Mixed` - Mixed\n  * `Empty` - Empty\n",
      "enum": [
        "Dry",
        "Fresh",
        "Frozen",
        "Chilled",
        "DeepFrozen",
        "Refrigerated",
        "Protect",
        "Produce",
        "Mixed",
        "Empty"
      ]
    },
