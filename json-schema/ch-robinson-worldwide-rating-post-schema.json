    },
    "platform": {
      "type": "string",
      "description": "A static ID that represents an external party to C.H. Robinson. It can be used by C.H. Robinson to route external rate requests based on specific customer needs. To use this field, C.H. Robinson must generate and provide this ID to the external party. \n\n ### <span style=\"color:Red\">**This field is required for TMC customers.  Reach out to your TMC Representative to obtain this ID.</span> \n\n ### <span style=\"color:Red\">**Note that the API team does not provide this ID, and the majority of customers will not be using this field.</span>"
    },
