      "type": "array",
      "description": "Defines all charges properties",
      "items": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer",
            "description": "Currency amount left to pay."
          },
          "notes": {
            "type": "string",
            "description": "Notes about the charge."
          },
          "totalRateAmount": {
            "type": "number",
            "description": "Total currency amount of specific charge."
          },
          "rateCode": {
            "$ref": "#/$defs/rateCodeEnum"
