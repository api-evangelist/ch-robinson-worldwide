  "$defs": {
    "contact": {
      "type": "object",
      "description": "Object containing contact information.",
      "required": [
        "name",
        "type",
        "companyName",
        "contactMethods"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minimum": 1,
          "maximum": 200,
          "description": "Name of the contact."
        },
        "type": {
          "$ref": "#/$defs/contactTypeEnum"
        },
        "companyName": {
          "type": "string",
          "minimum": 1,
          "maximum": 100,
          "description": "Company name of the contact."
        },
        "contactMethods": {
          "type": "array",
          "description": "Contact Methods",
          "items": {
            "$ref": "#/$defs/contactMethod"
          }
        }
      }
    },
    "contactMethod": {
      "type": "object",
      "description": "Object defining contact method.",
      "required": [
        "method",
        "value"
      ],
      "properties": {
        "method": {
          "$ref": "#/$defs/contactMethodEnum"
        },
        "value": {
          "type": "string",
          "minimum": 1,
          "maximum": 50,
          "description": "Actual content of contact information."
        }
      }
    },
    "contactMethodEnum": {
      "type": "string",
      "description": "Indicates the best method for reaching the specified contact.\n",
      "enum": [
        "Email",
        "Phone",
        "Fax"
      ]
    },
    "contactTypeEnum": {
      "type": "string",
      "description": "Indicates the type of contact specified:\n  * `Vendor` - Vendor party (Non Transportation Supplier)\n  * `Buyer` - Buyer Party\n  * `Contact` - Contact Party\n  * `OrderedBy` - Ordered By Party on the Order or Load\n  * `NotifyParty` - Notify Party\n  * `OnlineContact` - CHRWOnline Contact\n  * `SchedWith` - Scheduled With\n  * `POCustomer` - Customer on the Purchase Order\n",
      "enum": [
        "Vendor",
        "Buyer",
        "Contact",
        "OrderedBy",
        "NotifyParty",
        "OnlineContact",
        "SchedWith",
        "POCustomer"
      ]
    },
